{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nova-studio",
  "version": "2.2.0",
  "identifier": "com.dongzj1102.nova-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Nova Studio",
        "width": 1440,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Light",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#edf4fd",
        "devtools": true
      },
      {
        "label": "desktop-pet",
        "title": "露露 · Nova Studio",
        "url": "desktop-pet.html",
        "width": 204,
        "height": 168,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "externalBin": [
      "binaries/nova"
    ],
    "resources": [
      "binaries/theme/*",
      "binaries/export-html/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
